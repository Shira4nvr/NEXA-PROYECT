# Copia este archivo a ".env" y ajusta los valores

# Base de datos PostgreSQL en AWS RDS
# Formato: postgresql://usuario:password@endpoint:5432/nombre_bd?schema=public
DATABASE_URL="postgresql://admin:TU_PASSWORD@tutienda-db.xxxxx.us-east-1.rds.amazonaws.com:5432/postgres?schema=public"

# Cambia esto por una cadena larga y aleatoria en produccion
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-123456"

PORT=4000

# --- Conexion IAM a Aurora (autenticacion por token, sin password fijo) ---
# Requiere credenciales de AWS disponibles en la maquina (aws configure, o
# rol de IAM si corre en EC2/ECS). Nunca pegues aqui un token generado a mano:
# se regenera solo en cada conexion (ver src/config/iamDb.js).
AWS_REGION="us-east-2"
IAM_DB_HOST="database-2-instance-1.cpmo688mg0l4.us-east-2.rds.amazonaws.com"
IAM_DB_PORT=5432
IAM_DB_USER="app_iam_user"
IAM_DB_NAME="postgres"

# --- Conexion de solo lectura al endpoint lector de Aurora ---
READER_DB_HOST="database-2.cluster-ro-cpmo688mg0l4.us-east-2.rds.amazonaws.com"
READER_DB_PORT=5432
READER_DB_USER="postgres"
READER_DB_PASSWORD="TU_PASSWORD"
READER_DB_NAME="postgres"
