{
  "name": "@shein-clone/desktop",
  "version": "1.0.0",
  "description": "NEXO desktop marketplace application",
  "author": "NEXO",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "@shein-clone/shared": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tutienda.desktop",
    "productName": "NEXO",
    "electronVersion": "30.5.1",
    "directories": {
      "output": "../../release"
    },
    "files": ["dist/**/*", "electron/**/*"],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
